{
  "seed": 42,
  "run_prefix": "ardd1d_e4",
  "notes": "E4 = E2 + A2(ardd_resid). 엔트로피 기반 적응형 잔차만 켠 설정. E2와의 차이가 곧 A2의 기여다.",
  "data": {
    "ai_data_root": "artifacts/ai_data_20260825_101830",
    "memmap_cache": "artifacts/repr_cache",
    "profile_cache": "artifacts/profile_cache",
    "representation": "profile_v1",
    "use_profile_cache": true,
    "realizations_per_file": 8,
    "samples_per_file": 4,
    "clean_groups": ["Lab PD"],
    "noise_groups": [],
    "real_noisy_groups": ["Field PD"],
    "clean_labels": null
  },
  "split": {
    "ratios": { "train": 0.7, "val": 0.15, "test": 0.15 },
    "scope": "global"
  },
  "noise": {
    "kind": "cin",
    "mode": "maximum",
    "gain_min": 0.6,
    "gain_max": 1.4,
    "dropout_probability": 0.05
  },
  "cin": {
    "white_sigma": 6.0,
    "pink_sigma": 4.0,
    "harmonic_amplitudes": [10.0, 4.0, 2.0],
    "harmonic_orders": [1, 3, 5],
    "harmonic_axis": "phase",
    "pink_axis": "time",
    "randomize_harmonic_phase": true,
    "target_snr_db": null
  },
  "model": {
    "base_channels": 64,
    "channel_multipliers": [1, 2, 4],
