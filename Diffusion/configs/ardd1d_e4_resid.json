    "attention_stages": [2],
    "dropout": 0.0,
    "padding_mode": "circular"
  },
  "components": {
    "ardd_resid": true,
    "ardd_alpha": 0.5,
    "ardd_entropy_window": 9,
    "ardd_entropy_bins": 16,
    "ardd_entropy_source": "condition",
    "ardd_invert_entropy": false,
    "morph_attn": false,
    "morph_scales": [1, 3, 7],
    "morph_normalize": "none"
  },
  "diffusion": {
    "schedule": "linear",
    "timesteps": 1000,
    "loss_type": "l2"
  },
  "train": {
    "epochs": 200,
    "batch_size": 64,
    "learning_rate": 0.0002,
    "ema_decay": 0.999,
    "grad_clip": 1.0,
    "num_workers": 0,
